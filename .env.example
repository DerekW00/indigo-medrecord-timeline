# Copy to .env and fill in the key:  cp .env.example .env
# Required
OPENAI_API_KEY=sk-...
# Optional, defaults shown
OPENAI_MODEL=gpt-6-luna
# Use a separate absolute path for each running worker or evaluation.
MRT_DATA_DIR=./data
MRT_CONCURRENCY=16
MRT_MAX_PAGES=0
MRT_FAIL_AT_PAGE=0
MRT_RENDER_LONG_SIDE=1600
MRT_PORT=8000
# 1 = deterministic synthetic output; no real model calls.
MRT_FAKE_LLM=0
MRT_EXTRACT_EFFORT=low
MRT_SUMMARY_EFFORT=
